{
  "name": "wearther-mode-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts src/admin.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --packages=external",
    "start": "node dist/index.js",
    "dev": "npm run build && node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
