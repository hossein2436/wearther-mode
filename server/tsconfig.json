{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noUnusedLocals": true
  },
  "include": ["src", "test", "../src/engine", "../src/types.ts"],
  "exclude": ["../src/engine/__tests__"]
}
