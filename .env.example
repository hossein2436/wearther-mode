# Domain (or subdomain) whose DNS A record points to this server, e.g. app.wearthermode.com
# Use :80 to test over plain HTTP on the server IP (install-to-home-screen and push won't work without HTTPS).
SITE_ADDRESS=:80

# Host ports. Change only if something else (nginx, apache) already uses 80/443.
HTTP_PORT=80
HTTPS_PORT=443

# Optional: npm mirror used while building the image
# NPM_REGISTRY=https://registry.npmjs.org/
