# ---- Required ----
# Domain (or subdomain) whose DNS A record points to this server, e.g. app.example.com
SITE_ADDRESS=app.example.com
# Your contact email. MET Norway's terms require it in our User-Agent, and it signs push notifications.
CONTACT_EMAIL=you@example.com

# ---- Sign-in emails ----
# SMTP server for login codes, e.g. smtps://user:password@smtp.example.com:465
# Leave empty to start: codes are then printed in `docker compose logs api`.
SMTP_URL=
MAIL_FROM=Wearther Mode <no-reply@example.com>

# ---- Background removal ----
# u2net (~1.2 GB RAM) for small servers; isnet-general-use (~2 GB RAM) for cleaner edges.
REMBG_MODEL=u2net

# ---- Payments ----
# Leave empty until a provider is chosen; the paywall then says subscriptions open soon.
BILLING_PROVIDER=

# ---- Only for a quick test over plain HTTP on the server IP ----
# SITE_ADDRESS=:80 and COOKIE_SECURE=false (install-to-home-screen and push need HTTPS)
COOKIE_SECURE=true

# ---- Host ports (change only if nginx/apache already uses 80/443) ----
HTTP_PORT=80
HTTPS_PORT=443

# ---- Optional mirrors if registries are slow or blocked from your server ----
# Where base images (node, caddy, python) come from. No Docker daemon restart needed.
# BASE_REGISTRY=docker.io/library
# NPM_REGISTRY=https://registry.npmjs.org/
# PIP_INDEX_URL=https://pypi.org/simple
